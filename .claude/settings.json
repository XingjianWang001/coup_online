{
  "description": "TypeScript checks: typecheck and related tests after edits, lockfile guard before edits. Design hooks come from the impeccable plugin.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/check-ts.sh\"",
            "timeout": 60,
            "statusMessage": "Typecheck and related tests"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-lockfile.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
